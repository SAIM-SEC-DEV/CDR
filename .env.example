# FORGE API Configuration
PORT=8080
ENVIRONMENT=development
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s

# File upload settings
MAX_UPLOAD_SIZE=52428800
TEMP_DIR=/tmp/forge

# ClamAV configuration
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_USE_UNIX_SOCK=false
CLAMAV_UNIX_SOCKET_PATH=/var/run/clamav/clamd.ctl
CLAMAV_TIMEOUT=30s
